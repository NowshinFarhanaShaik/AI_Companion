# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://localhost:5432/studycompanion

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_STRONG=gemini-3.5-flash-lite
AI_MODEL_EMBED=gemini-embedding-001
TUTOR_MIN_SIMILARITY=0.55
EVAL_SLEEP_SECONDS=4

# Proxies that append to X-Forwarded-For (set to 1 behind Render), used for per-IP rate limits
NUM_PROXIES=0

# Used by `manage.py seed_demo`; required when DJANGO_DEBUG is false
DEMO_PASSWORD=
ADMIN_PASSWORD=

# Storage (production only)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Optional
SENTRY_DSN=
